# ============================================
# Marketplace3D — Backend Environment Variables
# CDC v1.3 — Complete list (§7.4 + infra)
# ============================================

# --- Server ---
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Database ---
DATABASE_URL=postgresql://mkpl:mkpl_secret@localhost:5432/marketplace3d

# --- Redis (BullMQ + rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=jwt-secret-change-to-secure-random-string
JWT_REFRESH_SECRET=jwt-refresh-secret-change-to-secure-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_CONNECT_VERSION=2024-06-20

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_IMAGES=marketplace3d-images
MINIO_BUCKET_FILES=marketplace3d-files
MINIO_BUCKET_MESSAGES=marketplace3d-messages
MINIO_REGION=us-east-1

# --- ClamAV (antivirus) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Sentry (error tracking) ---
SENTRY_DSN=

# --- Novu (notifications orchestration) ---
NOVU_API_KEY=novu-...
NOVU_APP_ID=novu-...
NOVU_ENVIRONMENT_URL=https://api.novu.co

# --- Resend (email) ---
RESEND_API_KEY=re-...

# --- Firebase (push notifications) ---
FIREBASE_PROJECT_ID=mkpl-3d
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Commission ---
COMMISSION_PCT=3
COMMISSION_FIXED_CENTS=80
PRICE_MIN_CENTS=300
OFFER_MIN_RATIO=0.5
OFFER_TTL_HOURS=48
OFFER_PAYMENT_TTL_HOURS=24
DEVIS_TTL_DAYS=7
DEVIS_PAYMENT_TTL_HOURS=48
CHECKOUT_TTL_MINUTES=30
DEMANDE_TTL_DAYS=15

# --- Shipping ---
SHIPPING_GRACE_DAYS=3
MAX_SHIPPING_DAYS=21
RELEASE_DELAY_SHIPPED_DAYS=7
RELEASE_DELAY_HANDOVER_DAYS=3

# --- Disputes ---
DISPUTE_SELLER_RESPONSE_HOURS=72

# --- Vacation / Reviews ---
VACATION_INACTIVITY_DAYS=15
REVIEW_WINDOW_DAYS=14

# --- Uploads ---
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_3D_MB=50

# --- Seller alerts ---
SELLER_ALERT_SALES=20
SELLER_ALERT_REVENUE_CENTS=150000

# --- Security ---
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
LOCKOUT_DURATION_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
